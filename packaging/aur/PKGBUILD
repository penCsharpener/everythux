# Maintainer: penCsharpener <noreply@users.noreply.github.com>
pkgname=everythux
pkgver=0.1.0
pkgrel=1
pkgdesc='Everything-style instant file search for Linux (ext4, SQLite)'
arch=('x86_64' 'aarch64')
url='https://github.com/penCsharpener/everythux'
license=('MIT' 'Apache-2.0')
depends=('gcc-libs' 'glibc' 'libglvnd' 'libxkbcommon' 'wayland')
makedepends=('cargo')
optdepends=(
  'poppler: PDF previews (pdftoppm)'
  'ffmpeg: audio and video previews'
  'xdg-utils: fallback for opening files and folders'
)
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP') # replace with `updpkgsums` output for a real release

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release -p everythux-app -p everythux-cli
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # Skips the tests that need root (loop-mounted ext4) or a session bus.
  cargo test --frozen --release -p everythux-core -p everythux-search -p everythux-cli
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/everythux     "$pkgdir/usr/bin/everythux"
  install -Dm755 target/release/everythux-cli "$pkgdir/usr/bin/everythux-cli"
  install -Dm644 packaging/everythux.desktop \
    "$pkgdir/usr/share/applications/everythux.desktop"
  install -Dm644 packaging/everythux.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/everythux.svg"
  install -Dm644 packaging/io.github.pencsharpener.Everythux.metainfo.xml \
    "$pkgdir/usr/share/metainfo/io.github.pencsharpener.Everythux.metainfo.xml"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 docs/*.md -t "$pkgdir/usr/share/doc/$pkgname/"
  for f in LICENSE LICENSE-MIT LICENSE-APACHE; do
    [ -e "$f" ] && install -Dm644 "$f" "$pkgdir/usr/share/licenses/$pkgname/$f"
  done
  return 0
}
